# Copiar este archivo a `.env` y rellenar con los valores reales del proyecto Supabase.
# Estos valores los consume principalmente el BFF (BFFBORR), que es quien habla
# con Supabase. Se documentan acá porque el schema y el contrato viven en este repo.

# Project URL — fija para el proyecto BoRR cloud.
PUBLIC_SUPABASE_URL=https://rikafvgarvjhnbkauxzi.supabase.co

# Anon key (legacy JWT) — Project Settings → API → "anon public".
# También funciona la "publishable" key (sb_publishable_...). No commitear.
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.example

# service_role — SOLO si alguna tarea administrativa lo requiere (migraciones via CLI
# usan tu login de supabase, no esta key). NUNCA con prefijo PUBLIC_ ni en el front.
# SUPABASE_SERVICE_ROLE_KEY=
